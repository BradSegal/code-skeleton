  "description": "Machine-readable successful artifact validation result.",
  "properties": {
    "artifact_type": {
      "const": "anatomize.artifact-check",
      "default": "anatomize.artifact-check",
      "title": "Artifact Type",
      "type": "string"
    },
    "checked_artifact_type": {
      "title": "Checked Artifact Type",
      "type": "string"
    },
    "checked_schema_version": {
      "title": "Checked Schema Version",
      "type": "string"
    },
    "identity": {
      "title": "Identity",
      "type": "string"
    },
    "message": {
