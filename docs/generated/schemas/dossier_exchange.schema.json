        },
        "record_id": {
          "minLength": 1,
          "title": "Record Id",
          "type": "string"
        },
        "record_kind": {
          "minLength": 1,
          "title": "Record Kind",
          "type": "string"
        },
        "relationship_ids": {
          "items": {
            "type": "string"
          },
          "title": "Relationship Ids",
          "type": "array"
        },
        "required": {
