            "type": "string"
          },
          "title": "Provider Ids",
          "type": "array"
        },
        "relationship_categories": {
          "items": {
            "type": "string"
          },
          "title": "Relationship Categories",
          "type": "array"
        },
        "roles": {
          "items": {
            "$ref": "#/$defs/EvidenceRole"
          },
          "title": "Roles",
          "type": "array"
        },
        "source_state_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source State Ids",
          "type": "array"
        }
      },
      "title": "DossierFilters",
      "type": "object"
    },
    "DossierGroup": {
