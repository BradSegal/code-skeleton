{
  "$defs": {
    "BudgetCounter": {
      "additionalProperties": false,
      "description": "One exact declared limit and its deterministic use.",
      "properties": {
        "limit": {
          "minimum": 0,
          "title": "Limit",
          "type": "integer"
        },
        "used": {
          "minimum": 0,
          "title": "Used",
          "type": "integer"
        }
      },
      "required": [
        "limit",
        "used"
      ],
      "title": "BudgetCounter",
      "type": "object"
    },
    "ContentClass": {
      "description": "Privacy-aware file/content classification.",
      "enum": [
        "ordinary",
        "binary",
        "large",
        "generated",
        "vendor",
        "ignored",
        "sensitive",
        "external",
        "opaque"
      ],
      "title": "ContentClass",
      "type": "string"
    },
    "ContentRange": {
      "additionalProperties": false,
      "description": "Half-open content range used by a dossier slice.",
      "properties": {
        "end_column": {
          "minimum": 0,
          "title": "End Column",
          "type": "integer"
        },
        "end_line": {
          "minimum": 1,
          "title": "End Line",
          "type": "integer"
        },
        "start_column": {
          "minimum": 0,
          "title": "Start Column",
          "type": "integer"
        },
        "start_line": {
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        }
      },
      "required": [
        "start_line",
        "start_column",
        "end_line",
        "end_column"
      ],
      "title": "ContentRange",
      "type": "object"
    },
    "Dossier": {
      "additionalProperties": false,
      "description": "Source-bound progressively expandable evidence dossier.",
      "properties": {
        "artifact_type": {
          "const": "anatomize.dossier",
          "default": "anatomize.dossier",
          "title": "Artifact Type",
          "type": "string"
        },
        "base_dossier_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Base Dossier Id"
        },
        "boundary": {
          "$ref": "#/$defs/DossierBoundary"
        },
        "budget_use": {
          "$ref": "#/$defs/DossierBudgetUse"
        },
        "content": {
          "items": {
            "$ref": "#/$defs/DossierContent"
          },
          "title": "Content",
          "type": "array"
        },
        "dossier_id": {
          "minLength": 1,
          "title": "Dossier Id",
          "type": "string"
        },
        "expansions": {
          "items": {
            "$ref": "#/$defs/ExpansionAction"
          },
          "title": "Expansions",
          "type": "array"
        },
        "groups": {
          "items": {
            "$ref": "#/$defs/DossierGroup"
          },
          "title": "Groups",
          "type": "array"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/DossierItem"
          },
          "title": "Items",
          "type": "array"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "omissions": {
          "items": {
            "$ref": "#/$defs/DossierOmission"
          },
          "title": "Omissions",
          "type": "array"
        },
        "policy_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Policy Digest",
          "type": "string"
        },
        "provider_run_ids": {
          "items": {
            "type": "string"
          },
          "title": "Provider Run Ids",
          "type": "array"
        },
        "repository_id": {
          "minLength": 1,
          "title": "Repository Id",
          "type": "string"
        },
        "request_id": {
          "minLength": 1,
          "title": "Request Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "session_id": {
          "minLength": 1,
          "title": "Session Id",
          "type": "string"
        },
        "session_manifest_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Session Manifest Digest",
          "type": "string"
        },
        "source_state_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 1,
          "title": "Source State Ids",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/DossierStatus"
        }
      },
      "required": [
        "dossier_id",
        "request_id",
        "session_id",
        "session_manifest_digest",
        "repository_id",
        "source_state_ids",
        "policy_digest",
        "status",
        "boundary",
        "budget_use"
      ],
      "title": "Dossier",
      "type": "object"
    },
    "DossierBoundary": {
      "additionalProperties": false,
      "description": "Question, authority, and task-specific proof boundary.",
      "properties": {
        "authority": {
          "title": "Authority",
          "type": "string"
        },
        "profile": {
          "$ref": "#/$defs/DossierProfile"
        },
        "question": {
          "title": "Question",
          "type": "string"
        },
        "satisfied_stop_conditions": {
          "items": {
            "type": "string"
          },
          "title": "Satisfied Stop Conditions",
          "type": "array"
        },
        "targets": {
          "items": {
            "$ref": "#/$defs/ResolvedTarget"
          },
          "title": "Targets",
          "type": "array"
        },
        "unsatisfied_stop_conditions": {
          "items": {
            "type": "string"
          },
          "title": "Unsatisfied Stop Conditions",
          "type": "array"
        }
      },
      "required": [
        "profile",
        "question",
        "targets",
        "authority"
      ],
      "title": "DossierBoundary",
      "type": "object"
    },
    "DossierBudget": {
      "additionalProperties": false,
      "description": "Explicit delivery bounds; no bound redefines proof completeness.",
      "properties": {
        "max_content_block_bytes": {
          "default": 8192,
          "minimum": 0,
          "title": "Max Content Block Bytes",
          "type": "integer"
        },
        "max_depth": {
          "default": 2,
          "maximum": 32,
          "minimum": 0,
          "title": "Max Depth",
          "type": "integer"
        },
        "max_disclosed_omission_ids": {
          "default": 8,
          "maximum": 1000,
          "minimum": 0,
          "title": "Max Disclosed Omission Ids",
          "type": "integer"
        },
        "max_inline_content_bytes": {
          "default": 24576,
          "minimum": 0,
          "title": "Max Inline Content Bytes",
          "type": "integer"
        },
        "max_items": {
          "default": 32,
          "minimum": 0,
          "title": "Max Items",
          "type": "integer"
        },
        "max_payload_bytes": {
          "default": 73728,
          "minimum": 4096,
          "title": "Max Payload Bytes",
          "type": "integer"
        }
      },
      "title": "DossierBudget",
      "type": "object"
    },
    "DossierBudgetUse": {
      "additionalProperties": false,
      "description": "Disaggregated result cost; payload bytes are measured canonical bytes.",
      "properties": {
        "depth": {
          "$ref": "#/$defs/BudgetCounter"
        },
        "inline_content_bytes": {
          "$ref": "#/$defs/BudgetCounter"
        },
        "items": {
          "$ref": "#/$defs/BudgetCounter"
        },
        "payload_bytes": {
          "$ref": "#/$defs/BudgetCounter"
        }
      },
      "required": [
        "items",
        "payload_bytes",
        "inline_content_bytes",
        "depth"
      ],
      "title": "DossierBudgetUse",
      "type": "object"
    },
    "DossierContent": {
      "additionalProperties": false,
      "description": "Deduplicated exact content transmitted separately from semantic roles.",
      "properties": {
        "content_class": {
          "$ref": "#/$defs/ContentClass"
        },
        "content_id": {
          "minLength": 1,
          "title": "Content Id",
          "type": "string"
        },
        "context_after": {
          "minimum": 0,
          "title": "Context After",
          "type": "integer"
        },
        "context_before": {
          "minimum": 0,
          "title": "Context Before",
          "type": "integer"
        },
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "enclosing_entity_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Enclosing Entity Id"
        },
        "external_locator": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "External Locator"
        },
        "full_content_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Full Content Digest",
          "type": "string"
        },
        "language": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Language"
        },
        "media_type": {
          "title": "Media Type",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "source_range": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContentRange"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source_state_id": {
          "title": "Source State Id",
          "type": "string"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        },
        "truncated": {
          "title": "Truncated",
          "type": "boolean"
        }
      },
      "required": [
        "content_id",
        "digest",
        "full_content_digest",
        "source_state_id",
        "content_class",
        "media_type",
        "context_before",
        "context_after",
        "truncated"
      ],
      "title": "DossierContent",
      "type": "object"
    },
    "DossierCursor": {
      "additionalProperties": false,
      "description": "Self-validating stable continuation bound to one query and source session.",
      "properties": {
        "base_dossier_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Base Dossier Digest",
          "type": "string"
        },
        "base_dossier_id": {
          "minLength": 1,
          "title": "Base Dossier Id",
          "type": "string"
        },
        "base_request_id": {
          "minLength": 1,
          "title": "Base Request Id",
          "type": "string"
        },
        "checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Checksum",
          "type": "string"
        },
        "expansion_kind": {
          "$ref": "#/$defs/ExpansionKind"
        },
        "ordered_after": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Ordered After",
          "type": "array"
        },
        "policy_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Policy Digest",
          "type": "string"
        },
        "query_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Query Digest",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "session_id": {
          "minLength": 1,
          "title": "Session Id",
          "type": "string"
        },
        "session_manifest_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Session Manifest Digest",
          "type": "string"
        }
      },
      "required": [
        "base_dossier_id",
        "base_dossier_digest",
        "base_request_id",
        "query_digest",
        "session_id",
        "session_manifest_digest",
        "policy_digest",
        "expansion_kind",
        "ordered_after",
        "checksum"
      ],
      "title": "DossierCursor",
      "type": "object"
    },
    "DossierExpansion": {
      "additionalProperties": false,
      "description": "One consumer-requested expansion over an immutable base dossier.",
      "properties": {
        "action_id": {
          "minLength": 1,
          "title": "Action Id",
          "type": "string"
        },
        "base_dossier_id": {
          "minLength": 1,
          "title": "Base Dossier Id",
          "type": "string"
        },
        "context_lines": {
          "default": 0,
          "maximum": 10000,
          "minimum": 0,
          "title": "Context Lines",
          "type": "integer"
        },
        "cursor": {
          "anyOf": [
            {
              "$ref": "#/$defs/DossierCursor"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "depth_increment": {
          "default": 0,
          "maximum": 32,
          "minimum": 0,
          "title": "Depth Increment",
          "type": "integer"
        },
        "kind": {
          "$ref": "#/$defs/ExpansionKind"
        },
        "role": {
          "anyOf": [
            {
              "$ref": "#/$defs/EvidenceRole"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "target_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Id"
        }
      },
      "required": [
        "kind",
        "base_dossier_id",
        "action_id"
      ],
      "title": "DossierExpansion",
      "type": "object"
    },
    "DossierFilters": {
      "additionalProperties": false,
